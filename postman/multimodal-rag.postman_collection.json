{
  "info": {
    "name": "Multimodal RAG",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "conversationId", "value": "" }
  ],
  "item": [
    {
      "name": "Server",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload PDF",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/uploads",
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": [] }]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Start conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('conversationId', pm.response.json().conversation.id);"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/conversations" }
        },
        {
          "name": "Ask a question (streams)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/conversations/{{conversationId}}/messages",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"How much revenue did Europe make in Q2?\"\n}"
            }
          }
        },
        {
          "name": "Conversation history",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/conversations/{{conversationId}}/messages"
          }
        }
      ]
    }
  ]
}
